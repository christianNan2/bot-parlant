# Foundry agent
AZURE_EXISTING_AGENT_NAME=Razor
AZURE_EXISTING_AGENT_VERSION=2
AZURE_EXISTING_AIPROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_PROJECT_NAME=your-project
AZURE_AI_RESOURCE_NAME=your-resource

# Public URL of this Flask app (HTTPS). Used in OpenAPI servers[] for the register_user tool.
# BACKEND_PUBLIC_URL=https://your-app.azurewebsites.net

# Azure SQL — dbo.Users (agent calls POST /api/users/register)
AZURE_SQL_SERVER=free-sql-db-voicebot-server.database.windows.net
AZURE_SQL_DATABASE=free-sql-db-voicebot
AZURE_SQL_PORT=1433
AZURE_SQL_USER=foyet
# Option A: Azure AD (recommended — no password)
# AZURE_SQL_USE_AAD=true
# Option B: SQL authentication
AZURE_SQL_PASSWORD=your-password
AZURE_SQL_USE_AAD=false

# Optional: require X-API-Key on /api/users/register (configure matching Foundry OpenAPI connection)
# REGISTRATION_API_KEY=

# Dashboard sign-in uses Azure SQL username/password via /api/dashboard/login.
# Server/database must be configured; credentials are not stored in .env for the dashboard.
# FLASK_SECRET_KEY=change-me-in-production
# FLASK_COOKIE_SECURE=true
